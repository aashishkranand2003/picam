[Unit]
Description=OptoCam WiFi Hotspot
# No longer Requires/After uap0.service — the ExecStartPre block below
# tears down and recreates the uap0 interface itself, so the pre-boot
# uap0.service is purely advisory and this service is independently startable.

[Service]
Type=forking

# 1. Kill any stale hostapd
ExecStartPre=/bin/sh -c 'kill $(cat /run/hostapd.pid 2>/dev/null) 2>/dev/null || true'

# 2. (Re-)create the uap0 AP interface — works whether uap0 already
#    exists from uap0.service or we are starting cold.
ExecStartPre=/bin/sh -c '\
    iw dev uap0 del 2>/dev/null || true; \
    sleep 0.2; \
    iw phy phy0 interface add uap0 type __ap; \
    sleep 0.2'

# 3. Match AP channel to whatever wlan0 is on (avoids interference)
ExecStartPre=/bin/sh -c '\
    CH=$(iw dev wlan0 info 2>/dev/null | awk "/channel/{print \$2}"); \
    [ -n "$CH" ] && sed -i "s/^channel=.*/channel=$CH/" /etc/hostapd/hostapd.conf || true'

# 4. Bring up the interface with the gateway address
ExecStartPre=/sbin/ip addr add 192.168.4.1/24 dev uap0
ExecStartPre=/sbin/ip link set uap0 up

ExecStart=/usr/sbin/hostapd -B -P /run/hostapd.pid /etc/hostapd/hostapd.conf
ExecStartPost=/bin/sh -c 'sleep 1 && systemctl start dnsmasq'

ExecStop=/bin/sh -c '\
    kill $(cat /run/hostapd.pid 2>/dev/null) || true; \
    systemctl stop dnsmasq; \
    ip addr flush dev uap0 || true'

PIDFile=/run/hostapd.pid

[Install]
WantedBy=multi-user.target

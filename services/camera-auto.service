[Unit]
Description=Optocam Zero Camera System
After=local-fs.target network.target pigpiod.service
Wants=pigpiod.service
ConditionPathExists=/home/aa/optocamzero.py

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/aa
ExecStart=/usr/bin/python3 /home/aa/optocamzero.py
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=SUDO_USER=aa
Nice=-10
CPUWeight=500
IOSchedulingClass=1
IOSchedulingPriority=2
IOWeight=400
OOMScoreAdjust=-100
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=false
ProtectSystem=false
ReadWritePaths=/home/aa /tmp /var/log
SupplementaryGroups=gpio spi i2c video dialout
TimeoutStartSec=60
TimeoutStopSec=10
KillMode=mixed
KillSignal=SIGINT
FinalKillSignal=SIGKILL
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target

[Unit]
Description=Optocam Zero Camera System
# network-online.target ensures wlan0 is connected before we start, so
# NetworkManager/wpa_supplicant are not starved for CPU by the camera.
After=local-fs.target network-online.target pigpiod.service
Wants=network-online.target pigpiod.service
ConditionPathExists=/home/dkumkum/optocamzero.py

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/dkumkum
ExecStart=/usr/bin/python3 /home/dkumkum/optocamzero.py
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=SUDO_USER=dkumkum

# ── Priority ──────────────────────────────────────────────────────────────────
# Nice -10: camera gets priority but wpa_supplicant can still get CPU
# to maintain the WiFi connection during boot (needed for SSH).
Nice=-10
# CPUWeight 10000 (max 10000, default 100): dominant cgroup CPU share.
CPUWeight=10000
# Highest I/O weight for SPI framebuffer writes and SD card photo saves.
IOSchedulingClass=1
IOSchedulingPriority=2
IOWeight=1000
# Never OOM-kill the camera process.
OOMScoreAdjust=-100

# ── Security (unchanged from original) ───────────────────────────────────────
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=false
ProtectSystem=false
ReadWritePaths=/home/dkumkum /tmp /var/log
SupplementaryGroups=gpio spi i2c video dialout

# ── Timeouts (unchanged) ─────────────────────────────────────────────────────
TimeoutStartSec=60
TimeoutStopSec=10
KillMode=mixed
KillSignal=SIGINT
FinalKillSignal=SIGKILL
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
